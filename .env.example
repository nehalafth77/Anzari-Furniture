# Backend Server Port
PORT=5000

# MongoDB Connection String
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/furniture_shop

# For MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/furniture_shop?retryWrites=true&w=majority

# Client API Base URL (if hosting backend on separate domain in production)
VITE_API_BASE_URL=http://localhost:5000
